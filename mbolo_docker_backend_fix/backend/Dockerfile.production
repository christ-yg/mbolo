# =============================================================================
# Mbolo — Image Docker de production du backend Django
# =============================================================================
#
# Cette image contient :
# - Python pour exécuter Django ;
# - les bibliothèques système nécessaires à PostgreSQL ;
# - les dépendances principales du backend ;
# - les dépendances temps réel pour Django Channels et WebSocket ;
# - un utilisateur système non privilégié nommé "mbolo".
#
# Le conteneur démarre Django avec Daphne, car Mbolo utilise une application
# ASGI et des fonctionnalités temps réel comme les WebSockets.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Image Python de base
# -----------------------------------------------------------------------------

FROM python:3.13-slim AS runtime


# -----------------------------------------------------------------------------
# 2. Configuration de Python et de pip
# -----------------------------------------------------------------------------
#
# PYTHONDONTWRITEBYTECODE :
# empêche Python de créer des fichiers temporaires .pyc.
#
# PYTHONUNBUFFERED :
# affiche immédiatement les journaux dans Docker.
#
# PIP_NO_CACHE_DIR :
# empêche pip de conserver son cache afin de réduire la taille de l’image.
# -----------------------------------------------------------------------------

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1


# -----------------------------------------------------------------------------
# 3. Dépendances système
# -----------------------------------------------------------------------------
#
# build-essential :
# outils nécessaires à la compilation de certains paquets Python.
#
# libpq-dev :
# bibliothèques nécessaires à PostgreSQL et psycopg.
#
# curl :
# utilisé notamment pour les contrôles de santé du conteneur.
#
# Le cache APT est supprimé après l’installation pour alléger l’image.
# -----------------------------------------------------------------------------

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*


# -----------------------------------------------------------------------------
# 4. Dossier de travail du backend
# -----------------------------------------------------------------------------

WORKDIR /app/backend


# -----------------------------------------------------------------------------
# 5. Installation des dépendances Python
# -----------------------------------------------------------------------------
#
# Le contexte de construction Docker correspond à la racine du projet Mbolo.
# Nous copions le dossier complet backend/requirements dans l’image.
#
# Les dépendances sont copiées avant le code source afin que Docker puisse
# réutiliser son cache lorsqu’aucune dépendance n’a changé.
# -----------------------------------------------------------------------------

COPY backend/requirements/ ./requirements/

RUN pip install \
        -r requirements/development.txt \
        -r requirements/realtime.txt


# -----------------------------------------------------------------------------
# 6. Copie du code source Django
# -----------------------------------------------------------------------------

COPY backend/ ./


# -----------------------------------------------------------------------------
# 7. Création de l’utilisateur non privilégié
# -----------------------------------------------------------------------------
#
# Le serveur ne doit pas fonctionner avec l’utilisateur root.
# Cela limite les conséquences d’une éventuelle compromission du conteneur.
#
# Les dossiers utilisés par Django sont créés avant le changement d’utilisateur :
# - staticfiles : fichiers statiques collectés par collectstatic ;
# - media : fichiers publics envoyés par les utilisateurs ;
# - private_media : fichiers privés ou sensibles.
# -----------------------------------------------------------------------------

RUN addgroup --system mbolo \
    && adduser --system --ingroup mbolo --home /home/mbolo mbolo \
    && mkdir -p \
        /app/backend/staticfiles \
        /app/backend/media \
        /app/backend/private_media \
    && chown -R mbolo:mbolo /app/backend /home/mbolo


# -----------------------------------------------------------------------------
# 8. Abandon des privilèges root
# -----------------------------------------------------------------------------

USER mbolo


# -----------------------------------------------------------------------------
# 9. Port interne du backend
# -----------------------------------------------------------------------------
#
# EXPOSE documente le port utilisé. Il ne publie pas directement le port sur
# Internet : cette responsabilité appartient à Docker Compose et à Nginx.
# -----------------------------------------------------------------------------

EXPOSE 8000


# -----------------------------------------------------------------------------
# 10. Démarrage de l’application ASGI
# -----------------------------------------------------------------------------
#
# Daphne exécute config.asgi:application sur toutes les interfaces internes
# du conteneur. Nginx transmettra ensuite les requêtes HTTP et WebSocket.
# -----------------------------------------------------------------------------

CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "config.asgi:application"]
