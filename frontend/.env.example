# ============================================================
# CONFIGURATION PUBLIQUE DU FRONTEND MBOLO
# ============================================================

# Chemin public utilisé par Axios dans le navigateur.
#
# En développement, le navigateur appellera :
#
#     http://127.0.0.1:5173/api/...
#
# Vite transmettra ensuite la requête au backend Django.
VITE_API_BASE_URL=/api


# ============================================================
# CIBLE DU PROXY DE DÉVELOPPEMENT
# ============================================================

# Adresse réelle du backend Django.
#
# Cette valeur est utilisée uniquement par le serveur Vite.
# Elle ne constitue pas un secret.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
