# Les dépendances peuvent être restaurées avec npm install.
node_modules/


# ============================================================
# COMPILATION VITE
# ============================================================

# Version de production générée par npm run build.
dist/
dist-ssr/

# Fichiers locaux générés par certains outils.
*.local


# ============================================================
# VARIABLES D'ENVIRONNEMENT
# ============================================================

# Les fichiers réels d'environnement peuvent contenir des
# paramètres propres à une machine ou à un environnement.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Le modèle documenté doit rester versionnable.
!.env.example


