{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "audit:production": "node scripts/audit-production.mjs",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/public-launch.spec.ts",
    "test:e2e:auth-core": "playwright test e2e/authenticated-core.spec.ts"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
