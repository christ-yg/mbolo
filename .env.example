# ==========================================================
# ENVIRONNEMENT GÉNÉRAL
# ==========================================================

APP_ENV=development
APP_NAME=Mbolo
APP_DEBUG=false

# ==========================================================
# DJANGO
# Ne jamais placer de vraie clé secrète dans ce fichier.
# ==========================================================

DJANGO_SECRET_KEY=replace-with-a-secure-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ==========================================================
# POSTGRESQL
# Valeurs fictives pour documenter la configuration.
# ==========================================================

POSTGRES_DB=mbolo
POSTGRES_USER=mbolo_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================================
# REDIS
# ==========================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-password

# ==========================================================
# FRONTEND
# ==========================================================

VITE_API_BASE_URL=http://localhost:8000/api


# ==========================================================
# CONFIGURATION DOCKER LOCALE
# ==========================================================

POSTGRES_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6379
