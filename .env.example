# ==========================================================
# MBOLO — EXEMPLE DE CONFIGURATION
# Copier vers .env puis remplacer toutes les valeurs fictives.
# Ne jamais committer le vrai fichier .env.
# ==========================================================

APP_ENV=development
APP_NAME=Mbolo
APP_DEBUG=true

# Clé Django longue, aléatoire et unique.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Listes séparées par des virgules.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# En local, laisser les protections HTTPS à false.
# En production HTTPS, les passer à true.
DJANGO_USE_HTTPS_SECURITY=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

FRONTEND_BASE_URL=http://localhost:5173
SERVE_MEDIA_LOCALLY=true

# ==========================================================
# POSTGRESQL
# ==========================================================

POSTGRES_DB=mbolo
POSTGRES_USER=mbolo_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Backend Django lancé depuis WSL :
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Ports publiés par Docker sur la machine locale.
POSTGRES_EXPOSED_PORT=5432

# ==========================================================
# REDIS
# ==========================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_EXPOSED_PORT=6379

# ==========================================================
# FRONTEND VITE
# ==========================================================

# Axios utilise des routes relatives /api/v1 afin de conserver les cookies.
VITE_API_BASE_URL=/api

# Cible du proxy Vite local.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ==========================================================
# E-MAILS
# ==========================================================

# Valeurs locales par défaut : Django écrit les e-mails dans ses logs.
# compose.email-local.yaml remplace automatiquement ces valeurs par Mailpit.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=Mbolo <no-reply@mbolo.local>
DJANGO_SERVER_EMAIL=Mbolo <no-reply@mbolo.local>

# Mettre true uniquement sur le futur serveur public.
DJANGO_REQUIRE_SMTP_EMAIL=false

# ==========================================================
# MBOLO PREMIUM — DÉVELOPPEMENT UNIQUEMENT
# ==========================================================

MBOLO_PLUS_PRICE_XAF=5000
MBOLO_PRESTIGE_PRICE_XAF=10000
MBOLO_PAYMENT_PROVIDER=mbolo_test
MBOLO_PAYMENT_TEST_MODE=true

MBOLO_FREE_DAILY_LIKE_LIMIT=20
PASSWORD_RESET_TIMEOUT=1800
