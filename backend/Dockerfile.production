# =============================================================================
# Mbolo — image Docker backend de production durcie
# =============================================================================
# L'étape builder compile et installe les dépendances dans un environnement
# virtuel isolé. L'étape runtime ne conserve ni compilateur, ni en-têtes de
# développement : une compromission du serveur dispose ainsi de moins d'outils.

FROM python:3.13-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

COPY backend/requirements/ /tmp/requirements/
RUN pip install --upgrade pip \
    && pip install \
        -r /tmp/requirements/development.txt \
        -r /tmp/requirements/realtime.txt


FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:${PATH}"

# libpq5 est la bibliothèque d'exécution PostgreSQL. curl reste disponible
# pour les diagnostics et contrôles de santé, sans conserver la chaîne de
# compilation utilisée uniquement dans l'étape builder.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app/backend
COPY backend/ ./

# Le serveur applicatif ne fonctionne jamais avec root.
RUN addgroup --system mbolo \
    && adduser --system --ingroup mbolo --home /home/mbolo mbolo \
    && mkdir -p \
        /app/backend/staticfiles \
        /app/backend/media \
        /app/backend/private_media \
    && chown -R mbolo:mbolo /app/backend /home/mbolo

USER mbolo

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=8s --retries=5 --start-period=60s \
  CMD python -c "import socket; s=socket.create_connection(('127.0.0.1',8000),5); s.close()" || exit 1

CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "config.asgi:application"]
