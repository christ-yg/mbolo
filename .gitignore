# ==========================================================
# SECRETS ET VARIABLES D'ENVIRONNEMENT
# ==========================================================

.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.p12
*.pfx

secrets/
credentials/

# ==========================================================
# PYTHON / DJANGO
# ==========================================================

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

*.sqlite3
db.sqlite3

staticfiles/
media/

# ==========================================================
# MÉDIAS DJANGO ET DONNÉES UTILISATEURS
# ==========================================================

# Médias publics téléversés localement.
backend/media/

# Médias privés : documents de vérification, photos privées, etc.
# Ils ne doivent jamais être envoyés sur GitHub.
backend/private_media/
private_media/

# Fichiers temporaires créés pendant le traitement des images.
backend/tmp/

# Autoriser uniquement d'éventuels fichiers .gitkeep servant
# à conserver une arborescence vide dans Git.
!backend/media/.gitkeep
!backend/private_media/.gitkeep

# ==========================================================
# NODE.JS / REACT
# ==========================================================

node_modules/
dist/
build/
coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================================
# IDE ET ÉDITEURS
# ==========================================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp
*.swo

# ==========================================================
# SYSTÈMES D'EXPLOITATION
# ==========================================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================================
# DOCKER ET DONNÉES LOCALES
# ==========================================================

docker-data/
postgres-data/
redis-data/

# ==========================================================
# TERRAFORM
# ==========================================================

.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan

crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================================================
# JOURNAUX ET FICHIERS TEMPORAIRES
# ==========================================================

*.log
logs/
tmp/
temp/
.cache/

# ==========================================================
# SAUVEGARDES LOCALES
# ==========================================================

*.bak
*.backup
*.old

# Toutes les sauvegardes créées par les installateurs Mbolo.
# Exemple : .super_like_backup_20260724_090824/
.*_backup_*/

# Variante de sécurité pour d'autres noms contenant "backup".
.*backup*/

# Archives locales de transfert ou d'installation.
mbolo_*_context.zip
mbolo_*_ready.zip
mbolo_*_installer.zip

# ==========================================================
# FICHIERS DE DÉVELOPPEMENT LOCAUX
# ==========================================================

*.local

# Sauvegardes temporaires générées pendant les installations
*.backup-*
*.zip:Zone.Identifier

# Environnement et artefacts de production
.env.production
backups/
